# Telegram bot token from @BotFather
BOT_TOKEN=replace_me

# Numeric Telegram user ID of the admin (run /id on @userinfobot)
ADMIN_ID=1289017759

# UPI ID shown on your QR (for display text)
UPI_ID=replace@upi

# Daily free limit
FREE_DAILY_LIMIT=3

# Auto-delete sent videos after N minutes
DELETE_AFTER_MINUTES=45

# Payment timer (minutes) — user has this long to send screenshot
PAY_TIMER_MINUTES=5

# Plans as JSON: id|label|priceINR|days(null = lifetime)
PLANS=25r5|5 Days|25|5,45r10|10 Days|45|10,65r15|15 Days|65|15,120r1m|1 Month|120|30,320r3m|3 Months|320|90,1500rlt|Lifetime|1500|null

# Optional: override diskwala extractor timeout (ms)
EXTRACT_TIMEOUT_MS=45000
