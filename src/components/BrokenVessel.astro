---
/**
 * BrokenVessel — elegant etching-style vessel with scroll-driven fracture animation
 * Designed as a signature visual motif: refined, aesthetic, matches the editorial vibe
 */
interface Props {
  static?: boolean;
  size?: number;
  class?: string;
}
const { static: isStatic = false, size = 220, class: klass = '' } = Astro.props;
const h = size;
const w = size * 0.52;
const hw = w * 0.5;
const neckY = h * 0.04;
const shoulderY = h * 0.085;
const upperY = h * 0.15;
const midY = h * 0.23;
const lowerY = h * 0.32;
const rimY = h * 0.38;
const chipY = h * 0.43;
const baseY = h * 0.76;
const bottomY = h * 0.93;
const rightX = w * 0.86;
const rightInnerX = w * 0.8;
const leftX = w * 0.14;
const leftInnerX = w * 0.36;
const centerX = hw;
const rightCurveX = w * 0.9;
const leftCurveX = w * 0.1;
const upperCurveX = w * 0.72;
const lowerCurveX = w * 0.28;
const fractureStartX = w * 0.26;
const fractureMidX = w * 0.36;
const fractureCenterX = hw;
const fractureUpperX = w * 0.64;
const fractureTopX = hw + w * 0.02;

// Pre-compute all path data as strings for clean interpolation
const vesselOutline = `M ${hw} ${neckY} 
  Q ${w * 0.88} ${shoulderY} ${w * 0.92} ${h * 0.3}
  Q ${w * 0.96} ${h * 0.55} ${upperCurveX} ${h * 0.75}
  Q ${hw} ${bottomY} ${lowerCurveX} ${h * 0.75}
  Q ${w * 0.04} ${h * 0.55} ${w * 0.08} ${h * 0.3}
  Q ${w * 0.12} ${shoulderY} ${hw} ${neckY} Z`;

const crack1 = `M ${hw} ${h * 0.085}
  Q ${hw + w * 0.025} ${h * 0.16} ${hw - w * 0.025} ${h * 0.28}`;
const crack2 = `M ${hw} ${h * 0.14}
  Q ${hw + w * 0.09} ${h * 0.21} ${hw + w * 0.15} ${h * 0.32}`;
const crack3 = `M ${hw} ${h * 0.14}
  Q ${hw - w * 0.09} ${h * 0.21} ${hw - w * 0.15} ${h * 0.32}`;
const crack4 = `M ${rightX} ${lowerY}
  Q ${rightInnerX} ${chipY} ${rightX} ${rimY}`;
const crack5 = `M ${fractureStartX} ${baseY}
  Q ${fractureMidX} ${h * 0.58} ${fractureCenterX} ${h * 0.34}
  Q ${fractureUpperX} ${h * 0.16} ${fractureTopX} ${h * 0.075}`;
---
<svg
  class:list={['broken-vessel', klass, { 'is-static': isStatic }]}
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Broken vessel motif — a fractured etching representing truth breaking through illusion"
>
  <defs>
    <style>
      /* Vessel outline — warm etching line with subtle glow */
      .vessel-outline {
        stroke: var(--vessel-stroke, #C9B896);
        stroke-width: 1.8;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.9;
        filter: drop-shadow(0 1px 2px rgba(0,0,0,0.4));
        transition: stroke 0.5s var(--ease-out-expo), opacity 0.5s var(--ease-out-expo);
      }

      /* Crack paths — gold/accent, drawn on via stroke-dashoffset */
      .crack-path {
        stroke: var(--vessel-crack, #D4A843);
        stroke-width: 1.4;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0;
        transition: stroke 0.5s var(--ease-out-expo),
                    stroke-dashoffset 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
                    opacity 0.4s var(--ease-out-expo),
                    transform 0.7s var(--ease-out-expo);
        transform-origin: center;
        filter: drop-shadow(0 0 1px var(--vessel-crack));
      }
      .crack-path[data-stage="1"] { stroke-dasharray: 58; stroke-dashoffset: 58; }
      .crack-path[data-stage="2"] { stroke-dasharray: 42; stroke-dashoffset: 42; }
      .crack-path[data-stage="3"] { stroke-dasharray: 40; stroke-dashoffset: 40; }
      .crack-path[data-stage="4"] { stroke-dasharray: 28; stroke-dashoffset: 28; }
      .crack-path[data-stage="5"] { stroke-dasharray: 72; stroke-dashoffset: 72; }
      .crack-path.active { stroke-dashoffset: 0; opacity: 1; }
      .crack-path.final-flash { 
        stroke: var(--vessel-flash, #F0C850); 
        opacity: 1; 
        filter: drop-shadow(0 0 4px var(--vessel-flash)) drop-shadow(0 0 8px var(--vessel-flash));
      }

      /* Static state (homepage) — show hairline + main fracture */
      .broken-vessel.is-static .crack-path { 
        stroke-dashoffset: 0; 
        opacity: 0.55; 
      }
      .broken-vessel.is-static .crack-path[data-stage="1"] { opacity: 1; }
      .broken-vessel.is-static .crack-path[data-stage="5"] { 
        transform: translateX(-5px); 
        opacity: 0.85; 
      }

      /* Reduced motion: show final fractured state */
      @media (prefers-reduced-motion: reduce) {
        .broken-vessel:not(.is-static) .crack-path { 
          stroke-dashoffset: 0; 
          opacity: 1; 
        }
        .broken-vessel:not(.is-static) .crack-path[data-stage="5"] { 
          transform: translateX(-5px); 
        }
      }

      /* Subtle ambient shimmer on the vessel outline */
      @keyframes vessel-shimmer {
        0%, 100% { opacity: 0.9; }
        50% { opacity: 1; }
      }
      .broken-vessel:not(.is-static) .vessel-outline {
        animation: vessel-shimmer 8s ease-in-out infinite;
      }
    </style>

    <!-- CSS custom properties for theming -->
    <style>
      :host {
        --vessel-stroke: #C9B896;
        --vessel-crack: #D4A843;
        --vessel-flash: #F0C850;
      }
    </style>
  </defs>

  <!-- Subtle background glow behind vessel -->
  <ellipse 
    cx={hw} cy={h * 0.52} 
    rx={w * 0.48} ry={h * 0.42} 
    fill="var(--vessel-crack)" 
    fill-opacity="0.03" 
    filter="blur(8px)"
    class="vessel-glow"
  />

  <!-- Vessel outline — elegant etching with warm gold tone -->
  <path class="vessel-outline" d={vesselOutline} />

  <!-- Stage 1: Hairline crack at neck (always visible on article pages) -->
  <path class="crack-path" data-stage="1" d={crack1} />

  <!-- Stage 2: Right branch from hairline -->
  <path class="crack-path" data-stage="2" d={crack2} />

  <!-- Stage 3: Left branch from hairline -->
  <path class="crack-path" data-stage="3" d={crack3} />

  <!-- Stage 4: Chip at right rim -->
  <path class="crack-path" data-stage="4" d={crack4} />

  <!-- Stage 5: Main fracture line — splits the vessel -->
  <path class="crack-path" data-stage="5" d={crack5} />
</svg>