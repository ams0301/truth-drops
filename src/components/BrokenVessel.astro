---
/**
 * BrokenVessel — Geometric amphora from provided SVG
 * Three fragments with kintsugi fracture animation
 * Pure outline version adapted from provided SVG
 */
interface Props {
  static?: boolean;
  size?: number;
  class?: string;
}
const { static: isStatic = false, size = 220, class: klass = '' } = Astro.props;

// Scale factor from original 690x630 viewBox
const scale = size / 630;
const w = 690 * scale;
const h = 630 * scale;
const cx = w * 0.5;

// Original coordinates scaled
const neckTop = 120 * scale;
const neckBottom = 180 * scale;
const shoulderBottom = 220 * scale;
const bellyTop = 220 * scale;
const bellyBottom = 420 * scale;
const baseBottom = 450 * scale;
const shadowY = 470 * scale;

const leftX = 284 * scale;
const rightX = 396 * scale;
const centerX = 340 * scale;
const neckLeft = 316 * scale;
const neckRight = 364 * scale;
const shoulderLeft = 284 * scale;
const shoulderRight = 396 * scale;
const bellyLeft = 284 * scale;
const bellyRight = 396 * scale;
const baseLeft = 300 * scale;
const baseRight = 380 * scale;

// Vessel outline - single continuous path (left side up, right side down)
const vaseOutline = `
  M ${neckLeft} ${neckTop}
  L ${neckRight} ${neckTop}
  L ${neckRight} ${neckBottom}
  L ${rightX} ${shoulderBottom}
  L ${rightX} ${bellyBottom}
  L ${baseRight} ${bellyBottom}
  L ${baseRight} ${baseBottom}
  L ${baseLeft} ${baseBottom}
  L ${leftX} ${bellyBottom}
  L ${leftX} ${bellyBottom}
  L ${leftX} ${shoulderBottom}
  L ${neckLeft} ${neckBottom}
  Z
`.trim().replace(/\s+/g, ' ');

// Crack path - the main fracture line
const crackPath = `
  M ${centerX} ${neckTop}
  L ${centerX} ${165 * scale}
  L ${centerX + 16 * scale} ${180 * scale}
  L ${centerX} ${210 * scale}
  L ${centerX + 16 * scale} ${250 * scale}
  L ${centerX - 10 * scale} ${285 * scale}
  L ${centerX + 10 * scale} ${320 * scale}
  L ${centerX - 18 * scale} ${355 * scale}
  L ${centerX + 4 * scale} ${390 * scale}
`.trim().replace(/\s+/g, ' ');

// Left fragment (separated piece)
const leftFragment = `
  M ${leftX} ${shoulderBottom}
  L ${centerX} ${210 * scale}
  L ${centerX + 16 * scale} ${250 * scale}
  L ${centerX - 10 * scale} ${285 * scale}
  L ${centerX + 10 * scale} ${320 * scale}
  L ${centerX - 18 * scale} ${355 * scale}
  L ${centerX + 4 * scale} ${390 * scale}
  L ${leftX} ${bellyBottom}
  Z
`.trim().replace(/\s+/g, ' ');

// Right fragment (separated piece)
const rightFragment = `
  M ${rightX} ${shoulderBottom}
  L ${centerX} ${210 * scale}
  L ${centerX + 16 * scale} ${250 * scale}
  L ${centerX - 10 * scale} ${285 * scale}
  L ${centerX + 10 * scale} ${320 * scale}
  L ${centerX - 18 * scale} ${355 * scale}
  L ${centerX + 4 * scale} ${390 * scale}
  L ${rightX} ${bellyBottom}
  Z
`.trim().replace(/\s+/g, ' ');

// Base
const base = `
  M ${baseLeft} ${bellyBottom}
  L ${baseRight} ${bellyBottom}
  L ${baseRight} ${baseBottom}
  L ${baseLeft} ${baseBottom}
  Z
`.trim().replace(/\s+/g, ' ');
---
<svg
  class:list={['broken-vessel', klass, { 'is-static': isStatic }]}
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Geometric amphora with kintsugi fracture — three fragments"
>
  <defs>
    <style>
      /* Vessel outline — clean geometric line */
      .vessel-outline {
        stroke: var(--vase-stroke, var(--text-secondary, #9C9A94));
        stroke-width: 1.5;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.9;
        filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3));
        transition: stroke 0.5s var(--ease-out-expo), opacity 0.5s var(--ease-out-expo);
      }

      /* Fragment fills */
      .vessel-body {
        fill: var(--vase-body, #1A1916);
        opacity: 0.6;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));
      }
      .fragment-left {
        fill: var(--vase-fragment-left, #2A2723);
        opacity: 0.9;
      }
      .fragment-right {
        fill: var(--vase-fragment-right, #1E1C18);
        opacity: 0.9;
      }
      .vase-base {
        fill: var(--vase-base, #161513);
        opacity: 0.8;
      }

      /* Crack path — kintsugi gold */
      .crack-path {
        stroke: var(--vase-crack, var(--accent, #C0392B));
        stroke-width: 1.3;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0;
        stroke-dasharray: 2, 2;
        transition: stroke 0.5s var(--ease-out-expo),
                    stroke-dashoffset 1.2s cubic-bezier(0.22, 0.61, 0.36, 1),
                    opacity 0.4s var(--ease-out-expo),
                    transform 0.7s var(--ease-out-expo),
                    stroke-opacity 0.4s var(--ease-out-expo);
        transform-origin: center;
        stroke-opacity: 0.65;
        filter: drop-shadow(0 0 1px var(--vase-crack));
      }
      .crack-path { stroke-dasharray: 180; stroke-dashoffset: 180; }
      .crack-path.active { stroke-dashoffset: 0; opacity: 1; stroke-opacity: 1; }
      .crack-path.final-flash {
        stroke: var(--vase-flash, var(--accent));
        stroke-opacity: 1;
        filter: drop-shadow(0 0 4px var(--vase-flash)) drop-shadow(0 0 8px var(--vase-flash));
      }

      /* Fragment pieces */
      .vessel-piece {
        transition: transform 0.8s var(--ease-out-expo), opacity 0.5s var(--ease-out-expo);
        transform-origin: center center;
        opacity: 1;
      }
      .vessel-piece.separated {
        transform: translateX(var(--tx, 0)) translateY(var(--ty, 0)) rotate(var(--rot, 0));
        opacity: 0.95;
      }

      /* Static state */
      .broken-vessel.is-static .crack-path {
        stroke-dashoffset: 0;
        opacity: 0.55;
        stroke-opacity: 0.65;
      }
      .broken-vessel.is-static .vessel-piece {
        opacity: 0.9;
      }

      @media (prefers-reduced-motion: reduce) {
        .broken-vessel:not(.is-static) .crack-path { stroke-dashoffset: 0; opacity: 1; stroke-opacity: 1; }
        .broken-vessel:not(.is-static) .vessel-piece { opacity: 1; }
      }

      /* Subtle shimmer on outline */
      @keyframes vessel-shimmer {
        0%, 100% { opacity: 0.92; }
        50% { opacity: 1; }
      }
      .broken-vessel:not(.is-static) .vessel-outline { animation: vessel-shimmer 14s ease-in-out infinite; }
      .vase-glow { animation: glow-pulse 10s ease-in-out infinite; }
      @keyframes glow-pulse { 0%, 100% { opacity: 0.015; } 50% { opacity: 0.035; } }
    </style>

    <style>
      :host {
        --vase-stroke: var(--text-secondary, #9C9A94);
        --vase-crack: var(--accent, #C0392B);
        --vase-flash: var(--accent, #C0392B);
      }
    </style>
  </defs>

  <!-- Subtle glow behind -->
  <ellipse class="vase-glow" cx="50%" cy="52%" rx="42%" ry="40%" fill="var(--vase-crack)" fill-opacity="0.018" filter="blur(14px)" />

  <!-- Vessel body (static, always visible) -->
  <path class="vessel-body" d={vaseOutline} />

  <!-- Vessel outline -->
  <path class="vessel-outline" d={vaseOutline} />

  <!-- Base -->
  <path class="vase-base" d={base} />

  <!-- Crack path (animated) -->
  <path class="crack-path" d={crackPath} />

  <!-- Left fragment (separates on fracture) -->
  <path class="vessel-piece fragment-left" d={leftFragment} data-tx="-12" data-ty="4" data-rot="-3deg" />

  <!-- Right fragment (separates on fracture) -->
  <path class="vessel-piece fragment-right" d={rightFragment} data-tx="12" data-ty="4" data-rot="3deg" />
</svg>