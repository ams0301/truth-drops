---
/**
 * BrokenVessel — elegant geometric porcelain vase
 * Classical symmetry, golden ratio proportions, refined kintsugi fractures
 */
interface Props {
  static?: boolean;
  size?: number;
  class?: string;
}
const { static: isStatic = false, size = 220, class: klass = '' } = Astro.props;
const h = size;
const w = size * 0.44; // Golden ratio-ish proportion

// Precise geometric construction
const cx = w * 0.5;
const neckTop = h * 0.025;
const neckBottom = h * 0.1;
const shoulderTop = h * 0.1;
const shoulderBottom = h * 0.16;
const bodyMax = h * 0.36;
const bodyBottom = h * 0.64;
const footTop = h * 0.64;
const footBottom = h * 0.72;
const baseBottom = h * 0.975;

const neckR = w * 0.16;
const shoulderR = w * 0.38;
const bodyR = w * 0.48;
const footR = w * 0.26;
const baseR = w * 0.14;

// Geometrically perfect paths using quadratic curves with symmetric control points
const vaseOutline = `
  M ${cx} ${neckTop}
  L ${cx + neckR} ${neckBottom}
  Q ${cx + shoulderR} ${shoulderTop} ${cx + shoulderR} ${shoulderBottom}
  Q ${cx + bodyR} ${bodyMax} ${cx + bodyR} ${h * 0.5}
  Q ${cx + bodyR} ${bodyBottom} ${cx + footR} ${footTop}
  Q ${cx + baseR} ${footBottom} ${cx + baseR} ${baseBottom}
  L ${cx - baseR} ${baseBottom}
  Q ${cx - baseR} ${footBottom} ${cx - footR} ${footTop}
  L ${cx - bodyR} ${bodyBottom}
  Q ${cx - bodyR} ${h * 0.5} ${cx - bodyR} ${bodyMax}
  Q ${cx - shoulderR} ${shoulderBottom} ${cx - shoulderR} ${shoulderTop}
  L ${cx - neckR} ${neckBottom}
  Z
`.trim().replace(/\s+/g, ' ');

// Symmetric crack system - 10 cracks in mirrored pairs + center
const neckCrack = `M ${cx} ${neckBottom} Q ${cx} ${h * 0.07} ${cx} ${h * 0.18}`;

const shoulderCrackR = `M ${cx + shoulderR * 0.3} ${shoulderBottom} Q ${cx + shoulderR * 0.7} ${h * 0.22} ${cx + shoulderR} ${h * 0.28}`;
const shoulderCrackL = `M ${cx - shoulderR * 0.3} ${shoulderBottom} Q ${cx - shoulderR * 0.7} ${h * 0.22} ${cx - shoulderR} ${h * 0.28}`;

const shoulderChipR = `M ${cx + shoulderR * 0.9} ${shoulderBottom} Q ${cx + shoulderR * 0.6} ${h * 0.2} ${cx + shoulderR * 0.9} ${h * 0.25}`;
const shoulderChipL = `M ${cx - shoulderR * 0.9} ${shoulderBottom} Q ${cx - shoulderR * 0.6} ${h * 0.2} ${cx - shoulderR * 0.9} ${h * 0.25}`;

const bodyCrackR = `M ${cx + bodyR * 0.4} ${h * 0.38} Q ${cx + bodyR * 0.8} ${h * 0.46} ${cx + bodyR * 0.6} ${h * 0.56}`;
const bodyCrackL = `M ${cx - bodyR * 0.4} ${h * 0.38} Q ${cx - bodyR * 0.8} ${h * 0.46} ${cx - bodyR * 0.6} ${h * 0.56}`;

const lowerCrackR = `M ${cx + footR * 0.7} ${footTop} Q ${cx + bodyR * 0.3} ${h * 0.58} ${cx + footR * 0.3} ${h * 0.68}`;
const lowerCrackL = `M ${cx - footR * 0.7} ${footTop} Q ${cx - bodyR * 0.3} ${h * 0.58} ${cx - footR * 0.3} ${h * 0.68}`;

const footCrackR = `M ${cx + footR * 0.8} ${footTop} Q ${cx + footR * 0.5} ${h * 0.7} ${cx + footR * 0.8} ${h * 0.78}`;
const footCrackL = `M ${cx - footR * 0.8} ${footTop} Q ${cx - footR * 0.5} ${h * 0.7} ${cx - footR * 0.8} ${h * 0.78}`;

const baseSplit = `M ${cx} ${h * 0.85} Q ${cx} ${h * 0.91} ${cx} ${baseBottom}`;
---
<svg
  class:list={['broken-vessel', klass, { 'is-static': isStatic }]}
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Elegant porcelain vase with kintsugi gold repair — symmetry and fracture"
>
  <defs>
    <style>
      /* Vase outline — refined porcelain line */
      .vase-outline {
        stroke: var(--vase-stroke, #C4B89A);
        stroke-width: 1.5;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.95;
        filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3));
        transition: stroke 0.5s var(--ease-out-expo), opacity 0.5s var(--ease-out-expo);
      }

      /* Subtle porcelain body */
      .vase-body {
        fill: var(--vase-fill, #1A1916);
        opacity: 0.55;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
      }

      /* Crack paths — pure kintsugi gold */
      .crack-path {
        stroke: var(--vase-crack, #D4B852);
        stroke-width: 1.2;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0;
        transition: stroke 0.5s var(--ease-out-expo),
                    stroke-dashoffset 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
                    opacity 0.35s var(--ease-out-expo),
                    transform 0.6s var(--ease-out-expo);
        transform-origin: center;
        filter: drop-shadow(0 0 1px var(--vase-crack));
      }

      /* 10 cracks in symmetric order */
      .crack-path[data-stage="1"]  { stroke-dasharray: 42;  stroke-dashoffset: 42;  }  /* Neck center */
      .crack-path[data-stage="2"]  { stroke-dasharray: 48;  stroke-dashoffset: 48;  }  /* Right shoulder */
      .crack-path[data-stage="3"]  { stroke-dasharray: 48;  stroke-dashoffset: 48;  }  /* Left shoulder */
      .crack-path[data-stage="4"]  { stroke-dasharray: 32;  stroke-dashoffset: 32;  }  /* Right shoulder chip */
      .crack-path[data-stage="5"]  { stroke-dasharray: 32;  stroke-dashoffset: 32;  }  /* Left shoulder chip */
      .crack-path[data-stage="6"]  { stroke-dasharray: 52;  stroke-dashoffset: 52;  }  /* Right body */
      .crack-path[data-stage="7"]  { stroke-dasharray: 52;  stroke-dashoffset: 52;  }  /* Left body */
      .crack-path[data-stage="8"]  { stroke-dasharray: 48;  stroke-dashoffset: 48;  }  /* Right lower */
      .crack-path[data-stage="9"]  { stroke-dasharray: 48;  stroke-dashoffset: 48;  }  /* Left lower */
      .crack-path[data-stage="10"] { stroke-dasharray: 50;  stroke-dashoffset: 50;  }  /* Base center split */

      .crack-path.active { stroke-dashoffset: 0; opacity: 1; }
      .crack-path.final-flash {
        stroke: var(--vase-flash, #F0D878);
        opacity: 1;
        filter: drop-shadow(0 0 3px var(--vase-flash)) drop-shadow(0 0 6px var(--vase-flash));
      }

      /* Static state */
      .broken-vessel.is-static .crack-path {
        stroke-dashoffset: 0;
        opacity: 0.45;
      }
      .broken-vessel.is-static .crack-path[data-stage="1"] { opacity: 1; }
      .broken-vessel.is-static .crack-path[data-stage="2"] { opacity: 0.6; }
      .broken-vessel.is-static .crack-path[data-stage="3"] { opacity: 0.6; }
      .broken-vessel.is-static .crack-path[data-stage="10"] { opacity: 0.55; transform: translateX(-2px); }

      @media (prefers-reduced-motion: reduce) {
        .broken-vessel:not(.is-static) .crack-path { stroke-dashoffset: 0; opacity: 1; }
        .broken-vessel:not(.is-static) .crack-path[data-stage="10"] { transform: translateX(-2px); }
      }

      /* Subtle shimmer */
      @keyframes vase-shimmer {
        0%, 100% { opacity: 0.95; }
        50% { opacity: 1; }
      }
      .broken-vessel:not(.is-static) .vase-outline { animation: vase-shimmer 12s ease-in-out infinite; }
      .vase-glow { animation: glow-pulse 8s ease-in-out infinite; }
      @keyframes glow-pulse { 0%, 100% { opacity: 0.02; } 50% { opacity: 0.04; } }
    </style>

    <style>
      :host {
        --vase-stroke: #C4B89A;
        --vase-fill: #1A1916;
        --vase-crack: #D4B852;
        --vase-flash: #F0D878;
      }
    </style>
  </defs>

  <!-- Subtle glow -->
  <ellipse class="vase-glow" cx="50%" cy="52%" rx="42%" ry="40%" fill="var(--vase-crack)" fill-opacity="0.02" filter="blur(12px)" />

  <!-- Porcelain body -->
  <path class="vase-body" d={vaseOutline} />

  <!-- Outline -->
  <path class="vase-outline" d={vaseOutline} />

  <!-- Cracks in symmetric pairs -->
  <path class="crack-path" data-stage="1" d={neckCrack} />                       <!-- 1: Neck center -->
  <path class="crack-path" data-stage="2" d={shoulderCrackR} />                   <!-- 2: Right shoulder -->
  <path class="crack-path" data-stage="3" d={shoulderCrackL} />                   <!-- 3: Left shoulder -->
  <path class="crack-path" data-stage="4" d={shoulderChipR} />                    <!-- 4: Right shoulder chip -->
  <path class="crack-path" data-stage="5" d={shoulderChipL} />                    <!-- 5: Left shoulder chip -->
  <path class="crack-path" data-stage="6" d={bodyCrackR} />                       <!-- 6: Right body -->
  <path class="crack-path" data-stage="7" d={bodyCrackL} />                       <!-- 7: Left body -->
  <path class="crack-path" data-stage="8" d={lowerCrackR} />                      <!-- 8: Right lower -->
  <path class="crack-path" data-stage="9" d={lowerCrackL} />                      <!-- 9: Left lower -->
  <path class="crack-path" data-stage="10" d={baseSplit} />                       <!-- 10: Base center -->
</svg>