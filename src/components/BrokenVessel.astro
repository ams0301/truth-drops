---
/**
 * BrokenVessel — single-stroke etching-style vessel with scroll-driven crack animation
 * Visible, elegant, matches the editorial aesthetic
 */
interface Props {
  static?: boolean;
  size?: number;
  class?: string;
}
const { static: isStatic = false, size = 200, class: klass = '' } = Astro.props;
const vesselHeight = size;
const vesselWidth = size * 0.6;
const halfW = vesselWidth * 0.5;
const neckY = vesselHeight * 0.045;
const shoulderY = vesselHeight * 0.09;
const upperY = vesselHeight * 0.16;
const midY = vesselHeight * 0.24;
const lowerY = vesselHeight * 0.33;
const chipY = vesselHeight * 0.38;
const rimY = vesselHeight * 0.44;
const baseY = vesselHeight * 0.78;
const bottomY = vesselHeight * 0.94;
const rightX = vesselWidth * 0.88;
const rightInnerX = vesselWidth * 0.82;
const leftX = vesselWidth * 0.12;
const leftInnerX = vesselWidth * 0.34;
const centerX = vesselWidth * 0.5;
const rightCurveX = vesselWidth * 0.9;
const leftCurveX = vesselWidth * 0.1;
const upperCurveX = vesselWidth * 0.75;
const lowerCurveX = vesselWidth * 0.25;
const fractureStartX = vesselWidth * 0.28;
const fractureMidX = vesselWidth * 0.38;
const fractureCenterX = vesselWidth * 0.5;
const fractureUpperX = vesselWidth * 0.62;
const fractureTopX = vesselWidth * 0.52;

// Pre-compute all path data as strings
const vesselOutline = `M ${halfW} ${neckY} Q ${vesselWidth * 0.88} ${shoulderY} ${vesselWidth * 0.9} ${vesselHeight * 0.33} Q ${vesselWidth * 0.92} ${vesselHeight * 0.58} ${vesselWidth * 0.72} ${vesselHeight * 0.78} Q ${halfW} ${bottomY} ${vesselWidth * 0.28} ${vesselHeight * 0.78} Q ${vesselWidth * 0.08} ${vesselHeight * 0.58} ${vesselWidth * 0.1} ${vesselHeight * 0.33} Q ${vesselWidth * 0.12} ${shoulderY} ${halfW} ${neckY} Z`;

const crack1 = `M ${halfW} ${vesselHeight * 0.09} Q ${halfW + vesselWidth * 0.03} ${vesselHeight * 0.17} ${halfW - vesselWidth * 0.03} ${vesselHeight * 0.3}`;
const crack2 = `M ${halfW} ${upperY} Q ${halfW + vesselWidth * 0.1} ${vesselHeight * 0.22} ${halfW + vesselWidth * 0.16} ${midY}`;
const crack3 = `M ${halfW} ${upperY} Q ${halfW - vesselWidth * 0.1} ${vesselHeight * 0.22} ${halfW - vesselWidth * 0.16} ${midY}`;
const crack4 = `M ${vesselWidth * 0.88} ${lowerY} Q ${vesselWidth * 0.82} ${chipY} ${vesselWidth * 0.88} ${rimY}`;
const crack5 = `M ${fractureStartX} ${baseY} Q ${fractureMidX} ${vesselHeight * 0.6} ${fractureCenterX} ${vesselHeight * 0.35} Q ${fractureUpperX} ${vesselHeight * 0.18} ${fractureTopX} ${vesselHeight * 0.09}`;
---
<svg
  class:list={['broken-vessel', klass, { 'is-static': isStatic }]}
  viewBox={`0 0 ${vesselWidth} ${vesselHeight}`}
  width={vesselWidth}
  height={vesselHeight}
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <style>
      .vessel-outline {
        stroke: var(--text-secondary);
        stroke-width: 1.5;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.7;
        filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3));
        transition: stroke 0.4s var(--ease-out-expo), opacity 0.4s var(--ease-out-expo);
      }
      .crack-path {
        stroke: var(--accent);
        stroke-width: 1.3;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0;
        transition: stroke 0.4s var(--ease-out-expo),
                    stroke-dashoffset 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    opacity 0.3s var(--ease-out-expo),
                    transform 0.6s var(--ease-out-expo);
        transform-origin: center;
      }
      .crack-path[data-stage="1"] { stroke-dasharray: 55; stroke-dashoffset: 55; }
      .crack-path[data-stage="2"] { stroke-dasharray: 38; stroke-dashoffset: 38; }
      .crack-path[data-stage="3"] { stroke-dasharray: 36; stroke-dashoffset: 36; }
      .crack-path[data-stage="4"] { stroke-dasharray: 26; stroke-dashoffset: 26; }
      .crack-path[data-stage="5"] { stroke-dasharray: 68; stroke-dashoffset: 68; }
      .crack-path.active { stroke-dashoffset: 0; opacity: 1; }
      .crack-path.final-flash { stroke: var(--accent); opacity: 1; filter: drop-shadow(0 0 3px var(--accent)); }
      .broken-vessel.is-static .crack-path { stroke-dashoffset: 0; opacity: 0.6; }
      .broken-vessel.is-static .crack-path[data-stage="1"] { opacity: 1; }
      .broken-vessel.is-static .crack-path[data-stage="5"] { transform: translateX(-4px); opacity: 0.8; }
      @media (prefers-reduced-motion: reduce) {
        .broken-vessel:not(.is-static) .crack-path { stroke-dashoffset: 0; opacity: 1; }
        .broken-vessel:not(.is-static) .crack-path[data-stage="5"] { transform: translateX(-4px); }
      }
    </style>
  </defs>

  <!-- Vessel outline — visible, elegant etching -->
  <path class="vessel-outline" d={vesselOutline} />

  <!-- Stage 1: Hairline crack at neck -->
  <path class="crack-path" data-stage="1" d={crack1} />

  <!-- Stage 2: Right branch -->
  <path class="crack-path" data-stage="2" d={crack2} />

  <!-- Stage 3: Left branch -->
  <path class="crack-path" data-stage="3" d={crack3} />

  <!-- Stage 4: Chip at right rim -->
  <path class="crack-path" data-stage="4" d={crack4} />

  <!-- Stage 5: Main fracture line -->
  <path class="crack-path" data-stage="5" d={crack5} />
</svg>