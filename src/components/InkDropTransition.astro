---
/**
 * InkDropTransition — page transition overlay with falling drop + expanding ripple
 * Used via View Transitions API interception
 * Mounted once in Base.astro, triggered by JS module
 */
---
<div id="ink-drop-transition" class="ink-drop-transition" aria-hidden="true" hidden>
  <svg class="ink-drop-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
    <!-- Drop (filled teardrop) -->
    <path class="ink-drop" d="M 50 5
      C 50 5, 75 20, 75 50
      C 75 70, 50 95, 50 95
      C 50 95, 25 70, 25 50
      C 25 20, 50 5, 50 5 Z" />
    <!-- Ripple rings (stroke only) -->
    <circle class="ink-ripple ink-ripple--1" cx="50" cy="50" r="0" />
    <circle class="ink-ripple ink-ripple--2" cx="50" cy="50" r="0" />
  </svg>
</div>

<style>
  .ink-drop-transition {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }
  .ink-drop-svg {
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
    transform-origin: center center;
  }
  .ink-drop {
    fill: var(--accent);
    transform-origin: 50% 95%;
    transform: translateY(-120vh) scale(0.6);
    opacity: 0;
    filter: drop-shadow(0 4px 12px rgba(192,57,43,0.3));
  }
  .ink-ripple {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    opacity: 0;
    transform-origin: 50% 50%;
  }
  .ink-ripple--1 { stroke-width: 2.5; }
  .ink-ripple--2 { stroke-width: 1.5; animation-delay: 0.08s; }

  /* Animation states controlled via JS classes */
  .ink-drop-transition.playing .ink-drop {
    animation: drop-fall 0.45s var(--ease-out-expo) forwards;
  }
  .ink-drop-transition.playing .ink-ripple {
    animation: ripple-expand 0.55s var(--ease-out-expo) forwards;
  }
  .ink-drop-transition.revealing .ink-drop-svg {
    clip-path: circle(0% at 50% 50%);
    animation: clip-reveal 0.6s var(--ease-out-expo) forwards;
  }

  @keyframes drop-fall {
    0% { transform: translateY(-120vh) scale(0.6); opacity: 0; }
    15% { opacity: 1; }
    60% { transform: translateY(0) scale(1.1, 0.7); opacity: 1; }
    75% { transform: translateY(0) scale(0.95, 1.05); opacity: 1; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }
  @keyframes ripple-expand {
    0% { r: 0; opacity: 0.6; }
    50% { opacity: 0.4; }
    100% { r: 75; opacity: 0; }
  }
  @keyframes clip-reveal {
    0% { clip-path: circle(0% at 50% 50%); }
    100% { clip-path: circle(150% at 50% 50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-drop,
    .ink-ripple,
    .ink-drop-svg { animation: none !important; }
  }
</style>