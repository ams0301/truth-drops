---
/**
 * InkDropTransition — elegant page transition overlay
 * Slow, refined, classic feel matching the editorial aesthetic
 * Single ink drop falls, creates a subtle ripple that becomes the page reveal
 */
---
<div id="ink-drop-transition" class="ink-drop-transition" aria-hidden="true" hidden>
  <svg class="ink-drop-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
    <!-- Single elegant drop -->
    <path class="ink-drop" d="M 50 5
      C 50 5, 68 18, 68 42
      C 68 60, 50 90, 50 90
      C 50 90, 32 60, 32 42
      C 32 18, 50 5, 50 5 Z" />
    <!-- Two subtle ripple rings -->
    <circle class="ink-ripple ink-ripple--1" cx="50" cy="50" r="0" />
    <circle class="ink-ripple ink-ripple--2" cx="50" cy="50" r="0" />
  </svg>
</div>

<style>
  .ink-drop-transition {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }
  .ink-drop-svg {
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
  }
  .ink-drop {
    fill: var(--accent);
    transform-origin: 50% 90%;
    transform: translateY(-110vh) scale(0.5);
    opacity: 0;
    filter: drop-shadow(0 2px 8px rgba(192,57,43,0.15));
  }
  .ink-ripple {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    opacity: 0;
    transform-origin: 50% 50%;
  }
  .ink-ripple--1 { stroke-width: 1.8; }
  .ink-ripple--2 { stroke-width: 1; }

  /* Animation states controlled via JS classes */
  .ink-drop-transition.playing .ink-drop {
    animation: drop-fall 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  .ink-drop-transition.playing .ink-ripple {
    animation: ripple-expand 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  .ink-drop-transition.revealing .ink-drop-svg {
    clip-path: circle(0% at 50% 50%);
    animation: clip-reveal 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes drop-fall {
    0% { transform: translateY(-110vh) scale(0.5); opacity: 0; }
    8% { opacity: 0.3; }
    15% { opacity: 1; }
    55% { transform: translateY(0) scale(1.15, 0.65); opacity: 1; }
    65% { transform: translateY(0) scale(0.9, 1.1); opacity: 1; }
    75% { transform: translateY(0) scale(1.02, 0.98); opacity: 1; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }
  @keyframes ripple-expand {
    0% { r: 0; opacity: 0; }
    25% { opacity: 0.25; }
    45% { opacity: 0.15; }
    100% { r: 85; opacity: 0; }
  }
  @keyframes clip-reveal {
    0% { clip-path: circle(0% at 50% 50%); }
    100% { clip-path: circle(150% at 50% 50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-drop,
    .ink-ripple,
    .ink-drop-svg { animation: none !important; }
  }
</style>