---
/**
 * InkDropTransition — beautiful, visible ink-in-water page transition
 * Reliable, visible, aesthetic — triggers on every internal navigation
 */
---
<div id="ink-drop-transition" class="ink-drop-transition" aria-hidden="true" hidden>
  <svg class="ink-drop-svg" viewBox="0 0 500 500" preserveAspectRatio="none">
    <defs>
      <!-- Realistic ink diffusion filter -->
      <filter id="ink-diffusion" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur1"/>
        <feGaussianBlur in="SourceGraphic" stdDeviation="12" result="blur2"/>
        <feBlend in="blur1" in2="blur2" mode="screen" result="combined"/>
        <feComponentTransfer in="combined">
          <feFuncA type="table" tableValues="0 0.1 0.25 0.45 0.65 0.85 1"/>
        </feComponentTransfer>
      </filter>

      <!-- Ink color gradients -->
      <radialGradient id="ink-core" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.98"/>
        <stop offset="25%" stop-color="var(--accent)" stop-opacity="0.7"/>
        <stop offset="55%" stop-color="var(--accent)" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
      </radialGradient>

      <radialGradient id="ink-outer" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.4"/>
        <stop offset="40%" stop-color="var(--accent)" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
      </radialGradient>

      <radialGradient id="ink-tendril" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
      </radialGradient>

      <radialGradient id="ink-particle" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.8"/>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <!-- Layer 1: Core ink drop (dense, saturated center) -->
    <circle class="ink-core" cx="250" cy="250" r="0" fill="url(#ink-core)" filter="url(#ink-diffusion)"/>

    <!-- Layer 2: Outer diffusion cloud -->
    <circle class="ink-outer" cx="250" cy="250" r="0" fill="url(#ink-outer)" filter="url(#ink-diffusion)"/>

    <!-- Layer 3: Organic tendrils (6 paths growing outward) -->
    <g class="ink-tendrils" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" filter="url(#ink-diffusion)">
      <path class="tendril t1" d="M250,250" stroke-dasharray="300" stroke-dashoffset="300" stroke-opacity="0"/>
      <path class="tendril t2" d="M250,250" stroke-dasharray="280" stroke-dashoffset="280" stroke-opacity="0"/>
      <path class="tendril t3" d="M250,250" stroke-dasharray="260" stroke-dashoffset="260" stroke-opacity="0"/>
      <path class="tendril t4" d="M250,250" stroke-dasharray="240" stroke-dashoffset="240" stroke-opacity="0"/>
      <path class="tendril t5" d="M250,250" stroke-dasharray="220" stroke-dashoffset="220" stroke-opacity="0"/>
      <path class="tendril t6" d="M250,250" stroke-dasharray="200" stroke-dashoffset="200" stroke-opacity="0"/>
    </g>

    <!-- Layer 4: Fine particle dispersion (12 particles) -->
    <g class="ink-particles" fill="var(--accent)" fill-opacity="0.7">
      <circle class="particle p1" cx="250" cy="250" r="0"/>
      <circle class="particle p2" cx="250" cy="250" r="0"/>
      <circle class="particle p3" cx="250" cy="250" r="0"/>
      <circle class="particle p4" cx="250" cy="250" r="0"/>
      <circle class="particle p5" cx="250" cy="250" r="0"/>
      <circle class="particle p6" cx="250" cy="250" r="0"/>
      <circle class="particle p7" cx="250" cy="250" r="0"/>
      <circle class="particle p8" cx="250" cy="250" r="0"/>
      <circle class="particle p9" cx="250" cy="250" r="0"/>
      <circle class="particle p10" cx="250" cy="250" r="0"/>
      <circle class="particle p11" cx="250" cy="250" r="0"/>
      <circle class="particle p12" cx="250" cy="250" r="0"/>
    </g>

    <!-- Layer 5: Expanding ripple rings (2 rings) -->
    <g class="ink-ripples" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-opacity="0">
      <circle class="ripple r1" cx="250" cy="250" r="0" stroke-width="2"/>
      <circle class="ripple r2" cx="250" cy="250" r="0" stroke-width="1"/>
    </g>
  </svg>
</div>

<style>
  .ink-drop-transition {
    position: fixed;
    inset: 0;
    z-index: 99999;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }
  .ink-drop-svg {
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
  }

  /* Core drop — dense, saturated, falls with physics */
  .ink-core {
    transform-origin: 250px 250px;
    transform: translateY(-240vh) scale(0.25);
    opacity: 0;
  }

  /* Outer diffusion cloud — larger, transparent */
  .ink-outer {
    transform-origin: 250px 250px;
    transform: translateY(-240vh) scale(0.15);
    opacity: 0;
  }

  /* Tendrils — organic paths growing outward */
  .ink-tendrils .tendril {
    stroke: var(--accent);
    stroke-width: 2.2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    stroke-opacity: 0;
    filter: drop-shadow(0 0 1.5px var(--accent));
  }

  /* Particles — fine dispersion */
  .ink-particles .particle {
    transform-origin: 250px 250px;
    transform: translateY(-240vh) scale(0);
    opacity: 0;
  }

  /* Ripples — expanding rings */
  .ink-ripples .ripple {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-opacity: 0;
    transform-origin: 250px 250px;
  }

  /* ===== ANIMATION STATES ===== */

  /* Playing state - drop falls, outer expands, tendrils grow */
  .ink-drop-transition.playing .ink-core {
    animation: core-fall 1.6s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .ink-drop-transition.playing .ink-outer {
    animation: outer-fall 1.9s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .ink-drop-transition.playing .ink-tendrils .tendril {
    animation: tendril-grow 2.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  .ink-drop-transition.playing .ink-particles .particle {
    animation: particle-disperse 2.6s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .ink-drop-transition.playing .ink-ripples .ripple {
    animation: ripple-expand 2.0s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  /* Revealing state - clip-path reveal using the ink as mask */
  .ink-drop-transition.revealing .ink-drop-svg {
    clip-path: circle(0% at 50% 50%);
    animation: clip-reveal 2.4s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  /* Stagger tendril animations for organic feel */
  .ink-drop-transition.playing .tendril.t1 { animation-delay: 0.12s; }
  .ink-drop-transition.playing .tendril.t2 { animation-delay: 0.18s; }
  .ink-drop-transition.playing .tendril.t3 { animation-delay: 0.24s; }
  .ink-drop-transition.playing .tendril.t4 { animation-delay: 0.30s; }
  .ink-drop-transition.playing .tendril.t5 { animation-delay: 0.36s; }
  .ink-drop-transition.playing .tendril.t6 { animation-delay: 0.42s; }

  /* Stagger particles */
  .ink-drop-transition.playing .particle.p1 { animation-delay: 0.35s; }
  .ink-drop-transition.playing .particle.p2 { animation-delay: 0.40s; }
  .ink-drop-transition.playing .particle.p3 { animation-delay: 0.45s; }
  .ink-drop-transition.playing .particle.p4 { animation-delay: 0.50s; }
  .ink-drop-transition.playing .particle.p5 { animation-delay: 0.55s; }
  .ink-drop-transition.playing .particle.p6 { animation-delay: 0.55s; }
  .ink-drop-transition.playing .particle.p7 { animation-delay: 0.60s; }
  .ink-drop-transition.playing .particle.p8 { animation-delay: 0.60s; }
  .ink-drop-transition.playing .particle.p9 { animation-delay: 0.65s; }
  .ink-drop-transition.playing .particle.p10 { animation-delay: 0.65s; }
  .ink-drop-transition.playing .particle.p11 { animation-delay: 0.70s; }
  .ink-drop-transition.playing .particle.p12 { animation-delay: 0.70s; }

  /* Stagger ripples */
  .ink-drop-transition.playing .ripple.r1 { animation-delay: 0.45s; }
  .ink-drop-transition.playing .ripple.r2 { animation-delay: 0.55s; }

  /* ===== KEYFRAMES ===== */

  @keyframes core-fall {
    0% { transform: translateY(-260vh) scale(0.2); opacity: 0; }
    4% { opacity: 0.15; }
    10% { opacity: 0.6; }
    16% { opacity: 1; }
    48% { transform: translateY(0) scale(1.35, 0.45); opacity: 1; }
    60% { transform: translateY(0) scale(0.82, 1.18); opacity: 1; }
    70% { transform: translateY(0) scale(1.03, 0.97); opacity: 1; }
    80% { transform: translateY(0) scale(1.01, 0.99); opacity: 1; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }

  @keyframes outer-fall {
    0% { transform: translateY(-260vh) scale(0.12); opacity: 0; }
    8% { opacity: 0.12; }
    18% { opacity: 0.45; }
    52% { transform: translateY(0) scale(1.9, 0.55); opacity: 0.55; }
    68% { transform: translateY(0) scale(1.12, 0.88); opacity: 0.45; }
    82% { transform: translateY(0) scale(1.04, 0.96); opacity: 0.38; }
    100% { transform: translateY(0) scale(1); opacity: 0.32; }
  }

  @keyframes tendril-grow {
    0% { stroke-dashoffset: 300; stroke-opacity: 0; }
    12% { stroke-opacity: 0.55; }
    35% { stroke-opacity: 0.75; }
    65% { stroke-opacity: 0.6; }
    100% { stroke-dashoffset: 0; stroke-opacity: 0; }
  }

  @keyframes particle-disperse {
    0% { transform: translateY(-260vh) scale(0); opacity: 0; }
    22% { opacity: 0.65; }
    52% { transform: translateY(var(--py, 0)) translateX(var(--px, 0)) scale(1); opacity: 0.55; }
    78% { opacity: 0.22; }
    100% { transform: translateY(var(--py-end, 0)) translateX(var(--px-end, 0)) scale(0.4); opacity: 0; }
  }

  @keyframes ripple-expand {
    0% { r: 0; stroke-opacity: 0; }
    15% { stroke-opacity: 0.35; }
    45% { stroke-opacity: 0.18; }
    100% { r: 280; stroke-opacity: 0; }
  }

  @keyframes clip-reveal {
    0% { clip-path: circle(0% at 50% 50%); }
    100% { clip-path: circle(170% at 50% 50%); }
  }

  /* Stagger tendrils */
  .ink-drop-transition.playing .tendril.t1 { animation-delay: 0.10s; }
  .ink-drop-transition.playing .tendril.t2 { animation-delay: 0.16s; }
  .ink-drop-transition.playing .tendril.t3 { animation-delay: 0.22s; }
  .ink-drop-transition.playing .tendril.t4 { animation-delay: 0.28s; }
  .ink-drop-transition.playing .tendril.t5 { animation-delay: 0.34s; }
  .ink-drop-transition.playing .tendril.t6 { animation-delay: 0.40s; }

  /* Stagger particles */
  .ink-drop-transition.playing .particle.p1 { animation-delay: 0.38s; }
  .ink-drop-transition.playing .particle.p2 { animation-delay: 0.42s; }
  .ink-drop-transition.playing .particle.p3 { animation-delay: 0.46s; }
  .ink-drop-transition.playing .particle.p4 { animation-delay: 0.50s; }
  .ink-drop-transition.playing .particle.p5 { animation-delay: 0.54s; }
  .ink-drop-transition.playing .particle.p6 { animation-delay: 0.54s; }
  .ink-drop-transition.playing .particle.p7 { animation-delay: 0.58s; }
  .ink-drop-transition.playing .particle.p8 { animation-delay: 0.58s; }
  .ink-drop-transition.playing .particle.p9 { animation-delay: 0.62s; }
  .ink-drop-transition.playing .particle.p10 { animation-delay: 0.62s; }
  .ink-drop-transition.playing .particle.p11 { animation-delay: 0.66s; }
  .ink-drop-transition.playing .particle.p12 { animation-delay: 0.66s; }

  /* Stagger ripples */
  .ink-drop-transition.playing .ripple.r1 { animation-delay: 0.50s; }
  .ink-drop-transition.playing .ripple.r2 { animation-delay: 0.62s; }

  @keyframes particle-disperse {
    0% { transform: translateY(-260vh) scale(0); opacity: 0; }
    24% { opacity: 0.7; }
    55% { transform: translateY(var(--py, 0)) translateX(var(--px, 0)) scale(1); opacity: 0.55; }
    80% { opacity: 0.2; }
    100% { transform: translateY(var(--py-end, 0)) translateX(var(--px-end, 0)) scale(0.35); opacity: 0; }
  }

  @keyframes clip-reveal {
    0% { clip-path: circle(0% at 50% 50%); }
    100% { clip-path: circle(175% at 50% 50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-core, .ink-outer, .ink-tendrils .tendril, .ink-particles .particle,
    .ink-ripples .ripple, .ink-drop-svg { animation: none !important; }
    .ink-drop-transition.revealing .ink-drop-svg {
      clip-path: circle(175% at 50% 50%);
    }
  }
</style>