---
import Base from './Base.astro';
import ControversialBadge from '../components/ControversialBadge.astro';
import Comments from '../components/Comments.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BrokenVessel from '../components/BrokenVessel.astro';
import { stamp, iso, readable, readingTime, tagSlug } from '../lib/format';
import { SITE } from '../config';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'articles'> }
const { post } = Astro.props;
const { data, body, slug } = post;
const url = `/drops/${slug}`;
const { Content } = await post.render();
const rt = readingTime(body);
const year = data.date.getUTCFullYear();

// Check for motif flag in frontmatter (default: true = show vessel)
const showMotif = data.motif !== false;

// Get related posts by shared tags (max 3, excluding current)
const allPosts = await getCollection('articles', (p) => !p.data.draft && p.slug !== slug);
const relatedPosts = allPosts
  .map(p => ({
    post: p,
    score: p.data.tags.filter(t => data.tags.includes(t)).length
  }))
  .filter(r => r.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3)
  .map(r => r.post);

// Primary tag for color coding
const primaryTag = data.tags[0]?.toLowerCase().replace(/[^\w]+/g, '-') ?? '';
---
<Base title={data.title} description={data.description}>
  <article class="drop" data-tag={primaryTag} data-motif={showMotif}>
    <header class="drop__head shell">
      <p class="drop__kicker reveal">
        <a href="/archive">The Archive</a>
        <span class="drop__kicker-sep">/</span>
        <span>{year}</span>
      </p>

      <h1 class="drop__title reveal">{data.title}</h1>
      {data.subtitle && <p class="drop__sub reveal">{data.subtitle}</p>}

      <div class="drop__meta reveal">
        <span class="drop__meta-item">Filed <time datetime={iso(data.date)}>{readable(data.date)}</time></span>
        <span class="drop__meta-sep">·</span>
        <span class="drop__meta-item">{rt} minute read</span>
        <span class="drop__meta-sep">·</span>
        <span class="drop__meta-item">{SITE.author}</span>
      </div>

      {showMotif && (
        <div class="drop__vessel">
          <BrokenVessel size={140} />
        </div>
      )}
    </header>

    <div class="shell drop__note-wrap">
      <ControversialBadge controversial={data.controversial} href={url} title={data.title} description={data.description} tag={primaryTag} />
    </div>

    <div class="prose drop__body reveal" id="article-body">
      <Content />
    </div>

    {relatedPosts.length > 0 && (
      <section class="shell drop__related reveal">
        <h2 class="drop__related-title">Related drops</h2>
        <div class="drop__related-grid">
          {relatedPosts.map(p => <ArticleCard post={p} variant="card" />)}
        </div>
      </section>
    )}

    <hr class="drop__end" />

    <p class="drop__correction">
      <a href={`mailto:${SITE.email}?subject=Correction:%20${encodeURIComponent(data.title)}`}>
        Spotted an error? Write to the editor
      </a>
    </p>

    <p class="drop__sign">
      <span class="drop__sign-mark">—</span>
      {SITE.author}, <em>{readable(data.date)}</em>
    </p>

    <div class="drop__cta">
      <a href="/" class="btn">&larr; Return to current issue</a>
      <a href="/rss.xml" class="btn btn--ghost">Subscribe via RSS</a>
    </div>

    {data.tags.length > 0 && (
      <aside class="shell drop__tags">
        <p class="drop__tags-label label">Filed under</p>
        <div class="drop__tags-list">
          {data.tags.map(t => <a class="tag" href={`/tags/${tagSlug(t)}`} data-tag={tagSlug(t)}>{t}</a>)}
        </div>
      </aside>
    )}

    <div class="shell">
      <Comments />
    </div>
  </article>
</Base>

<style>
  .drop__head { text-align: center; padding-block: clamp(3rem, 8vw, 6rem) 2rem; position: relative; }
  .drop__kicker {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    display: flex; gap: .7em; justify-content: center; flex-wrap: wrap;
  }
  .drop__kicker a { color: var(--text-secondary); text-decoration: none; border-bottom: 1px solid transparent; padding-bottom: 1px; transition: color var(--duration-fast) var(--ease-out-expo), border-color var(--duration-fast) var(--ease-out-expo); }
  .drop__kicker a:hover { color: var(--accent); border-color: var(--accent-soft); }
  .drop__kicker-sep { color: var(--rule-strong); }

  .drop__title {
    font-size: clamp(2.6rem, 6.5vw, 4.75rem);
    margin: 0 auto .35em;
    max-width: 24ch;
    font-weight: 300;
    line-height: 1.02;
    font-variation-settings: 'opsz' 144;
    font-style: italic;
  }
  .drop__sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2.6vw, 1.5rem);
    color: var(--text-secondary);
    max-width: 40ch;
    margin: 0 auto;
    font-variation-settings: 'opsz' 48;
  }

  .drop__meta {
    margin-top: 2rem;
    display: inline-flex; gap: .55em; justify-content: center; flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: .72rem;
    color: var(--text-muted);
    letter-spacing: .04em;
  }
  .drop__head { display: flex; flex-direction: column; align-items: center; }
  .drop__meta { align-self: center; }
  .drop__meta-sep { color: var(--rule-strong); }

  /* Vessel in article header */
  .drop__vessel {
    margin-top: 1.5rem;
    text-align: center;
    opacity: 0.7;
  }
  .drop[data-motif="false"] .drop__vessel { display: none; }

  .drop__note-wrap { display: flex; justify-content: center; }

  .drop__body { padding-block: 2.5rem 1rem; }

  /* Pull-quote styling */
  .drop__body .pull-quote,
  .drop__body blockquote.pull-quote {
    margin: 2.5em 0;
    padding: .5em 0 .5em 2em;
    border-left: 4px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.35rem;
    line-height: 1.45;
    color: var(--text-primary);
    font-variation-settings: 'opsz' 72;
    max-width: var(--measure-narrow);
  }
  .drop__body .pull-quote--right,
  .drop__body blockquote.pull-quote--right {
    border-left: none;
    border-right: 4px solid var(--accent);
    padding-left: 0;
    padding-right: 2em;
    margin-left: auto;
    text-align: right;
  }

  /* Margin note — floats in margin on wide viewports */
  .drop__body .margin-note {
    margin: 1.5em 0;
    padding: .75em 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: .9rem;
    line-height: 1.5;
    color: var(--text-secondary);
    font-variation-settings: 'opsz' 32;
    border-left: 2px solid var(--accent);
    background: var(--accent-pale);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .drop__body .margin-note::before {
    content: '';
    position: absolute;
    left: -8px; top: 50%;
    width: 6px; height: 1px;
    background: var(--accent);
    transform: translateY(-50%);
  }
  @media (min-width: 1400px) {
    .drop__body .margin-note {
      position: absolute;
      right: calc(var(--pad-x) + 100%);
      width: 220px;
      margin-right: 2rem;
      left: auto;
      border-left: none;
      border-bottom: 2px solid var(--accent);
      border-radius: var(--radius) var(--radius) 0 0;
      background: transparent;
    }
    .drop__body .margin-note::before {
      left: auto; right: -10px; top: auto; bottom: -2px;
      width: 1px; height: 8px;
      transform: none;
      background: var(--accent);
    }
  }

  .drop__end { margin-block: 3.5rem 1.5rem; border-top: 1px solid var(--ink-3); }

  .drop__related {
    padding-block: 2rem 0;
    border-top: 1px solid var(--ink-3);
    margin-top: 1rem;
  }
  .drop__related-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
    font-variation-settings: 'opsz' 48;
  }
  .drop__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .drop__correction {
    margin: 0 0 1.5rem;
    text-align: center;
  }
  .drop__correction a {
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color var(--duration-fast) var(--ease-out-expo), border-color var(--duration-fast) var(--ease-out-expo);
  }
  .drop__correction a:hover { color: var(--accent); border-color: var(--accent-soft); }

  .drop__sign {
    font-family: var(--font-display);
    font-style: normal;
    color: var(--text-secondary);
    font-size: 1rem;
    display: flex; align-items: baseline; gap: .6em;
    font-variation-settings: 'opsz' 36;
  }
  .drop__sign em { font-style: italic; color: var(--text-primary); }
  .drop__sign-mark { color: var(--accent); }
  .drop__cta { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 2rem; }

  .drop__tags {
    padding-block: 2.5rem;
    border-top: 1px solid var(--ink-3);
    border-bottom: 1px solid var(--ink-3);
    margin-top: 3rem;
    display: flex; align-items: baseline; gap: 1.5rem; flex-wrap: wrap;
  }
  .drop__tags-label {
    font-family: var(--font-mono);
    font-size: .72rem;
    color: var(--text-muted);
    letter-spacing: .12em;
    text-transform: uppercase;
    margin: 0;
  }
  .drop__tags-list { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* Editor note unfiling animation */
  .editor-note {
    opacity: 0;
    transform: rotate(-3deg) translateY(-20px) scale(.98);
    transition: opacity var(--duration-slow) var(--ease-out-expo),
                transform var(--duration-slow) var(--ease-out-expo);
    will-change: opacity, transform;
  }
  .editor-note.is-visible {
    opacity: 1;
    transform: rotate(0deg) translateY(0) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .editor-note { opacity: 1; transform: none; transition: none; }
  }

  /* Per-tag tint on article */
  .drop[data-tag="law"] .editor-note { border-color: var(--tag-law-accent); background: var(--tag-law); }
  .drop[data-tag="law"] .editor-note__mark { color: var(--tag-law-accent); }
  .drop[data-tag="politics"] .editor-note { border-color: var(--tag-politics-accent); background: var(--tag-politics); }
  .drop[data-tag="politics"] .editor-note__mark { color: var(--tag-politics-accent); }
  .drop[data-tag="culture"] .editor-note { border-color: var(--tag-culture-accent); background: var(--tag-culture); }
  .drop[data-tag="culture"] .editor-note__mark { color: var(--tag-culture-accent); }
  .drop[data-tag="attention"] .editor-note { border-color: var(--tag-attention-accent); background: var(--tag-attention); }
  .drop[data-tag="attention"] .editor-note__mark { color: var(--tag-attention-accent); }
  .drop[data-tag="ai"] .editor-note { border-color: var(--tag-ai-accent); background: var(--tag-ai); }
  .drop[data-tag="ai"] .editor-note__mark { color: var(--tag-ai-accent); }
  .drop[data-tag="psychology"] .editor-note { border-color: var(--tag-psychology-accent); background: var(--tag-psychology); }
  .drop[data-tag="psychology"] .editor-note__mark { color: var(--tag-psychology-accent); }
  .drop[data-tag="contrarian"] .editor-note { border-color: var(--tag-contrarian-accent); background: var(--tag-contrarian); }
  .drop[data-tag="contrarian"] .editor-note__mark { color: var(--tag-contrarian-accent); }
  .drop[data-tag="work"] .editor-note { border-color: var(--tag-work-accent); background: var(--tag-work); }
  .drop[data-tag="work"] .editor-note__mark { color: var(--tag-work-accent); }

  @media (max-width: 720px) {
    .drop__related-grid { grid-template-columns: 1fr; }
  }
</style>