---
import { SITE } from '../config';
import '../styles/global.css';

const { pathname } = Astro.url;
const year = new Date().getFullYear();

const nav = [
  { href: '/', label: 'Drops' },
  { href: '/tags', label: 'Tags' },
  { href: '/archive', label: 'Archive' },
  { href: '/about', label: 'About' },
];

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name}`;
const pageDesc = description ?? SITE.tagline;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? SITE.url).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0B0B0C" />
  </head>
  <body>
    <a href="#main" class="vh">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a href="/" class="brand" aria-label={SITE.name}>
          <span class="brand__name">{SITE.name}</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map(item => (
            <a
              href={item.href}
              class:list={['site-nav__link', { 'is-active': pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) }]}
            >
              {item.label}
            </a>
          ))}
          <a href="/rss.xml" class="site-nav__link site-nav__rss" aria-label="RSS feed">RSS</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div class="site-footer__col site-footer__col--lead">
          <a href="/" class="brand brand--footer">{SITE.name}</a>
          <p class="site-footer__tagline">{SITE.tagline}</p>
        </div>
        <div class="site-footer__col">
          <p class="site-footer__label">Sections</p>
          <ul class="site-footer__list">
            {nav.map(item => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href="/rss.xml">RSS Feed</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <p class="site-footer__label">Correspondence</p>
          <ul class="site-footer__list">
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="shell site-footer__bottom">
        <p>© {year} {SITE.author}. Set in Fraunces & Inter.</p>
        <p>{SITE.url.replace('https://', '')}</p>
      </div>
    </footer>

    <script>
      // Scroll-reveal observer (single, opt-in via .reveal)
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style>
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: rgba(11, 11, 12, 0.82);
        backdrop-filter: blur(14px) saturate(120%);
        -webkit-backdrop-filter: blur(14px) saturate(120%);
        border-bottom: 1px solid var(--line);
      }
      .site-header__inner {
        display: flex; align-items: baseline; justify-content: space-between;
        padding-block: 1.25rem;
        gap: 2rem;
      }
      .brand {
        display: inline-flex; align-items: baseline; gap: .35em;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.35rem;
        letter-spacing: -.01em;
        color: var(--text);
        text-decoration: none;
        font-variation-settings: 'opsz' 48;
      }
      .brand:hover { color: var(--accent); text-decoration: none; }

      .site-nav {
        display: flex; gap: 1.8rem; align-items: baseline;
        font-family: var(--font-body);
        font-size: .88rem;
        font-weight: 500;
        letter-spacing: .01em;
      }
      .site-nav__link {
        color: var(--text-dim);
        text-decoration: none;
        text-decoration-color: transparent;
        padding-block: .15em;
        border-bottom: 1px solid transparent;
        transition: color .2s var(--ease), border-color .2s var(--ease);
      }
      .site-nav__link:hover { color: var(--accent); border-color: var(--accent-soft); text-decoration: none; }
      .site-nav__link.is-active { color: var(--text); border-color: var(--accent); }
      .site-nav__rss { font-size: .8rem; color: var(--text-faint); margin-left: .4rem; }

      @media (max-width: 640px) {
        .site-nav { gap: 1.1rem; }
        .site-nav__rss { display: none; }
        .site-header__inner { padding-block: 1rem; }
      }

      .site-footer {
        margin-top: 6rem;
        border-top: 1px solid var(--line);
        padding-block: 4rem 2rem;
        background: transparent;
      }
      .site-footer__inner {
        display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 3rem;
      }
      .site-footer__col--lead .brand { font-size: 1.25rem; }
      .site-footer__tagline {
        color: var(--text-dim);
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1rem;
        max-width: 32ch;
        margin: .8rem 0 0;
        font-variation-settings: 'opsz' 36;
      }
      .site-footer__label {
        font-family: var(--font-mono);
        color: var(--text-faint);
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        margin: 0 0 1em;
      }
      .site-footer__list {
        list-style: none; padding: 0; margin: 0; display: grid; gap: .55em;
        font-size: .9rem;
      }
      .site-footer__list a {
        color: var(--text-dim);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        padding-bottom: 1px;
        transition: color .2s var(--ease), border-color .2s var(--ease);
      }
      .site-footer__list a:hover { color: var(--accent); border-color: var(--accent-soft); }
      .site-footer__bottom {
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem;
        margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line-fine);
        color: var(--text-faint); font-size: .78rem;
      }
      .site-footer__bottom p { margin: 0; }

      @media (max-width: 720px) {
        .site-footer__inner { grid-template-columns: 1fr; gap: 2rem; }
      }
    </style>
  </body>
</html>
