---
import { SITE } from '../config';
import '../styles/global.css';

const { pathname } = Astro.url;
const year = new Date().getFullYear();

const nav = [
  { href: '/', label: 'Drops' },
  { href: '/tags', label: 'Tags' },
  { href: '/archive', label: 'Archive' },
  { href: '/about', label: 'About' },
];

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name}`;
const pageDesc = description ?? SITE.tagline;

// Issue stamp data
const issueDate = new Date().toISOString().slice(0, 10).replace(/-/g, '.');
const issueNum = `№ ${issueDate}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? SITE.url).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0B0B0C" />
  </head>
  <body>
    <a href="#main" class="vh">Skip to content</a>

    <!-- Issue stamp — top right corner -->
    <div class="issue-stamp" aria-hidden="true">
      <span class="issue-stamp__mark">FILED</span>
      <span class="issue-stamp__num">{issueNum}</span>
      <span class="issue-stamp__diamond">◆</span>
    </div>

    <!-- Vertical bookmark-ribbon reading progress (replaces horizontal bar) -->
    <div class="reading-ribbon" aria-hidden="true">
      <div class="reading-ribbon__fill"></div>
    </div>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a href="/" class="brand" aria-label={SITE.name}>
          <span class="brand__name">{SITE.name}</span>
          <span class="brand__cursor" aria-hidden="true">|</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map(item => (
            <a
              href={item.href}
              class:list={['site-nav__link', { 'is-active': pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) }]}
            >
              {item.label}
            </a>
          ))}
          <a href="/rss.xml" class="site-nav__link site-nav__rss" aria-label="RSS feed">RSS</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div class="site-footer__col site-footer__col--lead">
          <a href="/" class="brand brand--footer">{SITE.name}</a>
          <p class="site-footer__tagline">{SITE.tagline}</p>
        </div>
        <div class="site-footer__col">
          <p class="site-footer__label">Sections</p>
          <ul class="site-footer__list">
            {nav.map(item => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href="/rss.xml">RSS Feed</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <p class="site-footer__label">Correspondence</p>
          <ul class="site-footer__list">
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="shell site-footer__bottom">
        <p>© {year} {SITE.author}. Set in Fraunces & Inter.</p>
        <p>{SITE.url.replace('https://', '')}</p>
      </div>
    </footer>

    <!-- Main interaction module -->
    <script type="module" src="/scripts/main.js"></script>

    <style>
      /* Issue stamp — top right, rotated, imperfect edge feel */
      .issue-stamp {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .25rem;
        pointer-events: none;
        opacity: .6;
        transform: rotate(2deg);
        font-family: var(--font-mono);
        font-size: .6rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--accent);
        filter: drop-shadow(0 1px 2px rgba(0,0,0,.4));
      }
      .issue-stamp__mark { font-weight: 600; }
      .issue-stamp__num { font-weight: 400; opacity: .8; }
      .issue-stamp__diamond { font-size: .8rem; margin-top: .2rem; }
      @media (max-width: 640px) {
        .issue-stamp { top: 1rem; right: 1rem; font-size: .5rem; }
      }

      /* Vertical reading ribbon — right edge */
      .reading-ribbon {
        position: fixed;
        top: 0; right: 0;
        width: 3px;
        height: 100vh;
        z-index: 80;
        pointer-events: none;
        background: linear-gradient(180deg, var(--ink-2) 0%, var(--ink-3) 100%);
        border-left: 1px solid var(--rule);
      }
      .reading-ribbon__fill {
        height: 0%;
        width: 100%;
        background: var(--accent);
        transition: height .1s linear;
        transform-origin: bottom;
      }

      /* Brand with typewriter cursor */
      .brand {
        display: inline-flex; align-items: baseline; gap: .15em;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.35rem;
        letter-spacing: -.01em;
        color: var(--text-primary);
        text-decoration: none;
        font-variation-settings: 'opsz' 48;
        transition: color var(--duration-fast) var(--ease-out-expo),
                    font-size var(--duration-base) var(--ease-out-expo);
      }
      .brand__cursor {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 1.1em;
        font-weight: 400;
        color: var(--accent);
        animation: typewriter-blink 1s steps(2, end) 3;
        animation-fill-mode: forwards;
        line-height: 1;
      }
      @keyframes typewriter-blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }
      .brand:hover { color: var(--accent); text-decoration: none; }
      .brand:hover .brand__cursor { animation: none; opacity: 1; color: var(--accent); }
      .site-header.is-shrunk .brand { font-size: 1.15rem; }

      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: rgba(11, 11, 12, 0.88);
        backdrop-filter: blur(16px) saturate(130%);
        -webkit-backdrop-filter: blur(16px) saturate(130%);
        border-bottom: 1px solid var(--rule);
        height: var(--header-h-lg);
        transition: height var(--duration-base) var(--ease-out-expo),
                    background var(--duration-base) var(--ease-out-expo),
                    border-color var(--duration-base) var(--ease-out-expo);
      }
      .site-header.is-shrunk {
        height: var(--header-h-sm);
        background: rgba(11, 11, 12, 0.95);
        border-color: var(--rule-strong);
      }
      .site-header__inner {
        display: flex; align-items: center; justify-content: space-between;
        height: 100%;
        padding-inline: var(--pad-x);
        gap: 2rem;
      }

      .site-nav {
        display: flex; gap: 1.8rem; align-items: center;
        font-family: var(--font-body);
        font-size: .88rem;
        font-weight: 500;
        letter-spacing: .01em;
      }
      .site-nav__link {
        color: var(--text-secondary);
        text-decoration: none;
        padding-block: .15em;
        position: relative;
      }
      .site-nav__link::after {
        content: '';
        position: absolute;
        left: 0; bottom: 2px;
        width: 0; height: 1px;
        background: currentColor;
        transition: width var(--duration-fast) var(--ease-out-expo);
      }
      .site-nav__link:hover { color: var(--accent); }
      .site-nav__link:hover::after,
      .site-nav__link.is-active::after { width: 100%; }
      .site-nav__link.is-active { color: var(--text-primary); }
      .site-nav__rss { font-size: .8rem; color: var(--text-muted); margin-left: .4rem; }
      .site-nav__rss::after { display: none; }

      @media (max-width: 640px) {
        .site-nav { gap: 1.1rem; }
        .site-nav__rss { display: none; }
      }

      .site-footer {
        margin-top: 6rem;
        border-top: 1px solid var(--rule);
        padding-block: 4rem 2rem;
        background: transparent;
      }
      .site-footer__inner {
        display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 3rem;
      }
      .site-footer__col--lead .brand { font-size: 1.25rem; }
      .site-footer__tagline {
        color: var(--text-secondary);
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1rem;
        max-width: 32ch;
        margin: .8rem 0 0;
        font-variation-settings: 'opsz' 36;
      }
      .site-footer__label {
        font-family: var(--font-mono);
        color: var(--text-muted);
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        margin: 0 0 1em;
      }
      .site-footer__list {
        list-style: none; padding: 0; margin: 0; display: grid; gap: .55em;
        font-size: .9rem;
      }
      .site-footer__list a {
        color: var(--text-secondary);
        text-decoration: none;
        padding-bottom: 1px;
      }
      .site-footer__list a:hover { color: var(--accent); border-color: var(--accent-soft); }
      .site-footer__bottom {
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem;
        margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--ink-3);
        color: var(--text-muted); font-size: .78rem;
      }
      .site-footer__bottom p { margin: 0; }

      @media (max-width: 720px) {
        .site-footer__inner { grid-template-columns: 1fr; gap: 2rem; }
      }
    </style>
  </body>
</html>