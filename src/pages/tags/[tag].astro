---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('articles', (p) => !p.data.draft);
  const tagMap = new Map<string, { tag: string; posts: typeof posts }>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      const slug = tagSlug(t);
      if (!tagMap.has(slug)) tagMap.set(slug, { tag: t, posts: [] });
      tagMap.get(slug)!.posts.push(p);
    }
  }
  return [...tagMap.entries()].map(([slug, { tag, posts }]) => ({
    params: { tag: slug },
    props: { tag, posts: posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) },
  }));
}

const { tag, posts } = Astro.props;
---
<Base title={`On ${tag}`} description={`All pieces concerning ${tag}.`}>
  <section class="shell page-head">
    <p class="page-head__eyebrow">Subject</p>
    <h1 class="page-head__title">{tag}.</h1>
    <p class="page-head__desc">{posts.length} {posts.length === 1 ? 'issue' : 'issues'} on this subject.</p>
    <p class="page-head__back"><a href="/tags">← Return to the Subject Index</a></p>
  </section>

  <section class="shell tag-grid-wrap">
    <div class="home-recent__grid">
      {posts.map((p) => <ArticleCard post={p} />)}
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 4vw, 3rem); text-align: center; }
  .page-head__eyebrow {
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }
  .page-head__title { font-style: italic; margin: 0 auto .6em; font-variation-settings: 'opsz' 144; }
  .page-head__desc { color: var(--text-dim); font-family: var(--font-display); font-style: italic; font-size: 1.05rem; font-variation-settings: 'opsz' 36; margin: 0 0 1.5rem; }
  .page-head__back a { color: var(--text-dim); font-size: .88rem; }
  .page-head__back a:hover { color: var(--accent); }

  .tag-grid-wrap { padding-bottom: 4rem; }
  .home-recent__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0 3rem;
    max-width: 1000px;
  }
</style>
