---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../lib/format';

const posts = (await getCollection('articles', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Index" description="Browse the publication by subject.">
  <section class="shell page-head">
    <p class="page-head__eyebrow">Subject Index</p>
    <h1 class="page-head__title">By topic.</h1>
    <p class="page-head__desc">{tags.length} subjects, {posts.length} issues.</p>
  </section>

  <section class="shell index-wrap">
    <ul class="index">
      {tags.map(([tag, n]) => (
        <li class="index__row">
          <a class="index__link" href={`/tags/${tagSlug(tag)}`}>
            <span class="index__label">{tag}</span>
            <span class="index__count">{n}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 4vw, 3rem); text-align: center; }
  .page-head__eyebrow {
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }
  .page-head__title { font-style: italic; margin: 0 auto .6em; font-variation-settings: 'opsz' 144; }
  .page-head__desc { color: var(--text-dim); font-family: var(--font-display); font-style: italic; font-size: 1.05rem; font-variation-settings: 'opsz' 36; }

  .index-wrap { padding-bottom: 4rem; max-width: 760px; }
  .index { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line-strong); }
  .index__row { border-bottom: 1px solid var(--line-fine); }
  .index__link {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: 1.1rem 0;
    text-decoration: none;
    color: var(--text);
    transition: color .2s var(--ease), padding .25s var(--ease);
  }
  .index__link:hover { color: var(--accent); padding-inline-start: .5rem; }
  .index__label {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    font-variation-settings: 'opsz' 48;
  }
  .index__count {
    font-family: var(--font-mono);
    font-size: .78rem;
    color: var(--text-faint);
    letter-spacing: .04em;
  }
</style>
